{
  "name": "@msr/stalls-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "LOG_PRETTY=1 tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:test:deploy": "tsx scripts/deploy-test-db.ts",
    "db:seed": "tsx prisma/seed.ts",
    "dev:signin": "tsx scripts/dev-signin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@msr/stalls": "*",
    "@prisma/adapter-pg": "8.1.0-dev.6",
    "@prisma/client": "8.1.0-dev.6",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.3",
    "pino-pretty": "^13.1.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "prisma": "8.1.0-dev.6",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
