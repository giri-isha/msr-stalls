// MSR Stalls — Phase 1 data model.
//
// Everything the module owns lives in the `stalls` Postgres schema and every
// model is prefixed `Stall`, following the host's multiSchema convention (its
// ADR 0007: `requirements`, `cycle_management`, `volunteering` each own a
// schema). At migration the `stalls` models are appended to the host's
// schema.prisma and `"stalls"` is added to its `schemas` list; nothing has to
// be renamed.
//
// The `foundation` schema below holds TWO STUB TABLES that stand in for the
// host's `Person` and activity trail. They are NOT migrated — the host has the
// real ones.
//
// Money is integer paise. Column names end in `_paise`. No floats, anywhere.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["foundation", "stalls"]
}

// ═══════════════════════════════════════════════════════════════════════════
// FOUNDATION STUBS — discarded at migration
// ═══════════════════════════════════════════════════════════════════════════

/// Stands in for the host's Person. A backoffice member who can sign in.
model Person {
  personId       String  @id @default(uuid()) @map("person_id") @db.Uuid
  email          String  @unique
  displayName    String  @map("display_name")
  /// The host's real `Person` carries one and this stub did not, so a backoffice
  /// member's number had nowhere to live: the directory showed a blank Phone cell
  /// for half its rows and the Edit dialog could not offer the field. Nullable
  /// for the host's reason — Isha's `phone_number` claim is optional, and a
  /// person staged by an admin may simply not have been given one.
  phone          String? @map("phone")
  /// An admin added this human here and nobody has signed in as them yet.
  ///
  /// ⚠️ **In the host this is not a column.** The real `Person` carries a
  /// nullable `sso_id`, and "staged" means it is null — the row waits for its
  /// owner's first Isha sign-in to claim it by email. This repo has no SSO at
  /// all (`auth.ts` signs a person in by looking their address up), so there is
  /// no `sso_id` to be null and the flag stands in for it. At migration the one
  /// derivation moves: `staged: true` becomes `ssoId === null`, in `backoffice.ts`
  /// and `directory.ts` and nowhere else.
  staged         Boolean @default(false) @map("staged")
  signInDisabled Boolean @default(false) @map("sign_in_disabled")

  @@map("person")
  @@schema("foundation")
}

/// Stands in for the host's activity trail.
model ActivityTrail {
  id         String   @id @default(uuid()) @db.Uuid
  actorRef   String   @map("actor_ref")
  moduleKey  String   @map("module_key")
  action     String
  subjectRef String   @map("subject_ref")
  detail     Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([moduleKey, subjectRef])
  @@map("activity_trail")
  @@schema("foundation")
}

// ═══════════════════════════════════════════════════════════════════════════
// STALLS MODULE — migrates verbatim
// ═══════════════════════════════════════════════════════════════════════════

// ── Enums ───────────────────────────────────────────────────────────────────

/// What somebody APPLIED as.
///
/// 🔴 `ASHRAM_FOOD` was a member and is not one now. The two ashram forms were
/// the same twenty-odd questions differing by whether the stall sells food —
/// which is `stall_type`, a column this table has always had, and the column
/// the FSSAI step, the rate card's food column and the planning grid already
/// read. Two request types for one fact meant a department declared it by
/// picking a form before being asked a question, and picking wrong was
/// unrecoverable.
///
/// ⚠️ The `AFD-` references those requests carry were NOT rewritten. They are
/// printed on challans; `RETIRED_PREFIX` in `reference.ts` is what still
/// parses them.
enum StallRequestType {
  ASHRAM
  LOCAL_WELFARE
  VENDOR

  @@schema("stalls")
}

/// What a stall SELLS. Distinct from StallPlanCategory, which is who OCCUPIES it.
enum StallType {
  FOOD
  NON_FOOD

  @@schema("stalls")
}

/// The selection decision. One axis.
enum StallRequestStatus {
  SUBMITTED
  SHORTLISTED
  SELECTED
  BACKUP
  REJECTED
  CANCELLED

  @@schema("stalls")
}

/// How far through onboarding a SELECTED request has travelled. The other axis.
/// Phase 1 drives only NEW; the rest are modelled so Phases 2–3 add behaviour,
/// not migrations that rewrite history.
enum StallStage {
  NEW
  BANK_FORM_SENT
  BANK_FORM_FILLED
  PAYMENT_SENT
  PAYMENT_CONFIRMED
  FSSAI_PENDING
  READY
  CHECKED_IN

  @@schema("stalls")
}

enum StallStatus {
  AVAILABLE
  ALLOCATED
  BLOCKED

  @@schema("stalls")
}

/// Which rate card column a requester is quoted from. A local welfare stall is
/// its own price for the same ground, not a discounted vendor stall.
enum StallRateScope {
  VENDOR
  LOCAL_WELFARE

  @@schema("stalls")
}

/// How a letter reached a requester. WhatsApp is the channel a village trader
/// actually reads; email is the only one that can carry an attachment.
enum StallMessageChannel {
  EMAIL
  WHATSAPP

  @@schema("stalls")
}

/// The module's own signature vocabulary. The provider's states are mapped into
/// this set by the adapter, so swapping providers never reaches a screen.
enum StallSignatureStatus {
  NOT_SENT
  SENT
  SIGNED
  DECLINED
  EXPIRED
  FAILED

  @@schema("stalls")
}

enum StallFormType {
  ASHRAM
  LOCAL_WELFARE
  VENDOR
  BANK
  FSSAI
  STAFF

  @@schema("stalls")
}

enum StallAccessPurpose {
  STATUS
  BANK_FORM
  FSSAI_UPLOAD
  STAFF_REGISTRATION
  /// A logged-in requester. Minted by the password login today; by the OIDC
  /// callback when SSO lands, which is the whole point of putting it here
  /// rather than building a session table beside it.
  SESSION
  /// ⚠️ DEAD. Registration is no longer confirmed — a credential works the
  /// moment it is created — so nothing mints one of these any more. The value
  /// stays because Postgres cannot drop an enum value without recreating the
  /// type, and recreating it would rewrite every access link to buy nothing.
  REGISTER_CONFIRM
  PASSWORD_RESET

  @@schema("stalls")
}

enum StallLoginKind {
  EMAIL
  MOBILE

  @@schema("stalls")
}

enum StallAshramUsage {
  DEPT_DISPLAY
  DEPT_SALES
  VENDOR_SALES
  SPONSOR
  OTHER

  @@schema("stalls")
}

// ── Configuration ───────────────────────────────────────────────────────────

/// One MSR. Everything hangs off an edition so 2027 does not reuse 2026's data.
model StallEdition {
  id        String   @id @default(uuid()) @db.Uuid
  year      Int      @unique
  name      String
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  /// The virtual-account prefixes Finance issues for this edition. The account a
  /// requester pays into is the prefix followed by their mobile number, and that
  /// string is the only link between a credit on a bank statement and a request
  /// here. Rent and the refundable advance go to DIFFERENT accounts because the
  /// advance comes back at the end of the edition and the rent does not.
  ///
  /// Null until Finance issues them — a new edition has none, and a payment
  /// letter must not print half an account number.
  virtualAccountRentPrefix    String? @map("virtual_account_rent_prefix")
  virtualAccountDepositPrefix String? @map("virtual_account_deposit_prefix")

  /// How many stalls one request may ask for in a single bay. Ground in a
  /// second bay is a second request, so the team can accept one and decline the
  /// other — "it will be easier for us to individually accept one and reject
  /// one".
  maxStallsPerRequest Int @default(2) @map("max_stalls_per_request")

  /// Where this edition's terms and conditions can be read.
  ///
  /// 🔴 The bank form records `agreedTermsAt` against a tick-box, and the 2025
  /// form that tick-box came from put a LINK beside it: "to view the terms and
  /// conditions document, please click here". Without somewhere to hold that
  /// link, a requester accepts terms they were never shown — which is the one
  /// consent on that form that has to be producible if a stall is ever in
  /// dispute.
  ///
  /// Null until the legal team issues the edition's document, and the form then
  /// shows the consent without a link rather than promising one that 404s. This
  /// is the wording people TICK; the signed agreement is a separate artefact
  /// with its own audit trail — see `StallContractSignature`.
  termsUrl String? @map("terms_url")

  zones           StallZone[]
  planCategories  StallPlanCategory[]
  rateCard        StallRateCard[]
  charges         StallChargeConfig?
  fineTypes       StallFineType[]
  formDefinitions StallFormDefinition[]
  customFields    StallFormField[]
  declarations    StallDeclaration[]
  flow            StallFlowConfig?
  requests        StallRequest[]
  sequences       StallReferenceSequence[]
  templates       StallEmailTemplate[]

  @@map("stall_edition")
  @@schema("stalls")
}

/// A bay. Created, renamed and removed from the Admin screen: the venue layout
/// is redrawn every year, so the set of bays is an edition's own data and never
/// a list baked into the code.
model StallZone {
  id                String  @id @default(uuid()) @db.Uuid
  editionId         String  @map("edition_id") @db.Uuid
  code              String
  name              String
  expectedCrowd     Int     @default(0) @map("expected_crowd")
  /// Closed to VENDORS, and to vendors only. Ashram and local welfare stalls
  /// stand in these — 2025's A3 and B2 held the VAP traders, who pay the most
  /// of any local welfare stall. This suppresses the vendor rent and the vendor
  /// form's option; it does NOT mean the bay cannot be priced, and the rate card
  /// carries local welfare rows for exactly these bays.
  isClosedToVendors Boolean @default(false) @map("is_closed_to_vendors")
  sortOrder         Int     @map("sort_order")

  edition StallEdition    @relation(fields: [editionId], references: [id], onDelete: Cascade)
  plan    StallZonePlan[]
  stalls  Stall[]

  @@unique([editionId, code])
  @@map("stall_zone")
  @@schema("stalls")
}

/// The Planning grid's columns, as data.
///
/// The planning sheet is redrawn every edition and which columns it carries is a
/// judgement the stall team makes each year, not a fact about the software. A
/// sponsor stall and an Adiyogi food stall are ashram stalls operationally, but
/// the whole point of the grid is to see how many of each are standing in a
/// bay, and a column that cannot be counted separately cannot be planned
/// against.
model StallPlanCategory {
  id        String  @id @default(uuid()) @db.Uuid
  editionId String  @map("edition_id") @db.Uuid
  key       String
  name      String
  isFood    Boolean @map("is_food")
  sortOrder Int     @map("sort_order")

  edition StallEdition    @relation(fields: [editionId], references: [id], onDelete: Cascade)
  plans   StallZonePlan[]
  stalls  Stall[]

  @@unique([editionId, key])
  @@map("stall_plan_category")
  @@schema("stalls")
}

/// The Planning grid: one row per zone × category.
model StallZonePlan {
  id           String @id @default(uuid()) @db.Uuid
  zoneId       String @map("zone_id") @db.Uuid
  categoryId   String @map("category_id") @db.Uuid
  plannedCount Int    @default(0) @map("planned_count")

  zone     StallZone         @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  category StallPlanCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([zoneId, categoryId])
  @@map("stall_zone_plan")
  @@schema("stalls")
}

/// The allocatable unit. Generated from the zone plan; editable by an admin.
model Stall {
  id         String      @id @default(uuid()) @db.Uuid
  zoneId     String      @map("zone_id") @db.Uuid
  /// `A4-17`. Unique within a zone.
  number     String
  categoryId String      @map("category_id") @db.Uuid
  status     StallStatus @default(AVAILABLE)

  category         StallPlanCategory @relation(fields: [categoryId], references: [id])
  zone             StallZone         @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  allocations      StallAllocation[] @relation("StallAllocationHistory")
  activeAllocation StallAllocation?  @relation("StallActiveAllocation")

  @@unique([zoneId, number])
  @@map("stall")
  @@schema("stalls")
}

/// One rent per bay × food/non-food × requester scope, and the refundable
/// advance for that same combination.
///
/// Priced per BAY rather than per band of bays: the rent genuinely differs bay
/// by bay — a VIP bay behind Adiyogi against a general-seating bay is a
/// different proposition — and banding them meant two bays that happened to
/// share a letter could never be priced apart.
///
/// The advance rides here rather than in the charge config so that it is
/// area-wise too, and so a bay's rent and its advance are edited together
/// instead of drifting apart in two screens.
model StallRateCard {
  id           String         @id @default(uuid()) @db.Uuid
  editionId    String         @map("edition_id") @db.Uuid
  zoneCode     String         @map("zone_code")
  isFood       Boolean        @map("is_food")
  scope        StallRateScope
  amountPaise  Int            @map("amount_paise")
  depositPaise Int            @map("deposit_paise")

  edition StallEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@unique([editionId, zoneCode, isFood, scope])
  @@map("stall_rate_card")
  @@schema("stalls")
}

/// Per-edition charges. Chair and table rates differ by requester type on the
/// 2025 forms (ashram: chair Rs.50/day; local welfare: chair Rs.100, table
/// Rs.300) — both are kept, neither is "the" rate.
model StallChargeConfig {
  id                   String @id @default(uuid()) @db.Uuid
  editionId            String @unique @map("edition_id") @db.Uuid
  chairRatePaise       Int    @map("chair_rate_paise")
  tableRatePaise       Int    @map("table_rate_paise")
  lwChairRatePaise     Int    @map("lw_chair_rate_paise")
  lwTableRatePaise     Int    @map("lw_table_rate_paise")
  /// The THIRD pair. The 2025 bank-details form quotes a vendor Rs.100/chair
  /// and Rs.400/table per day — neither the ashram figure above nor the local
  /// welfare one. Without these columns a vendor was billed at the ashram rate,
  /// which is the one requester type that is never billed at all.
  vendorChairRatePaise Int    @default(10000) @map("vendor_chair_rate_paise")
  vendorTableRatePaise Int    @default(40000) @map("vendor_table_rate_paise")
  plug5aRatePaise      Int    @map("plug_5a_rate_paise")
  plug15aRatePaise     Int    @map("plug_15a_rate_paise")
  gstPercent           Int    @default(18) @map("gst_percent")
  /// The Planning screen's divisor: expected crowd ÷ this = suggested stalls.
  crowdPerStall        Int    @default(1000) @map("crowd_per_stall")

  /// A flat refundable deposit against the furniture, charged once when any is
  /// taken. The 2025 payment sheet carries one figure per vendor in its
  /// "Chair and table Deposit" column, not a per-chair amount.
  chairTableDepositPaise Int @default(400000) @map("chair_table_deposit_paise")
  /// How many days the chairs and tables are held. The forms quote per-day
  /// rates; this is what they are multiplied by.
  equipmentDays          Int @default(1) @map("equipment_days")
  /// Charged against the deposit for furniture that does not come back.
  chairReplacementPaise  Int @default(40000) @map("chair_replacement_paise")
  tableReplacementPaise  Int @default(90000) @map("table_replacement_paise")
  damagePenaltyPaise     Int @default(25000) @map("damage_penalty_paise")

  edition StallEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@map("stall_charge_config")
  @@schema("stalls")
}

/// Phase 3 deducts these from the deposit. Phase 1 only configures them.
model StallFineType {
  id                 String  @id @default(uuid()) @db.Uuid
  editionId          String  @map("edition_id") @db.Uuid
  reason             String
  defaultAmountPaise Int     @map("default_amount_paise")
  isActive           Boolean @default(true) @map("is_active")

  edition StallEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@unique([editionId, reason])
  @@map("stall_fine_type")
  @@schema("stalls")
}

/// The wording a requester ticks, as data rather than as a constant.
///
/// 🔴 The disclaimer was a string in `packages/stalls/src/forms.ts` and the
/// consent was one `agreed_at` timestamp on the request. That records THAT
/// somebody agreed and never WHAT they agreed to — so the day a stall is in
/// dispute, the only answer available is whatever the constant says today,
/// which is not what it said when they ticked it. The edition already carries
/// `terms_url` with a comment about exactly this problem on the bank form.
///
/// ⚠️ Versions are IMMUTABLE. Editing the text writes a new row and archives
/// the old one; the consent rows go on pointing at the exact version that was
/// on screen. Nothing here is ever updated in place except `is_active`, which
/// decides whether a form still shows it and says nothing about what was
/// agreed in the past.
model StallDeclaration {
  id        String @id @default(uuid()) @db.Uuid
  editionId String @map("edition_id") @db.Uuid

  /// The declaration's identity, stable across versions and variants:
  /// `request_submission`, `deposit_terms`. Lower case with underscores.
  key String

  /// Which form this wording is for, or NULL for "any form without one of its
  /// own". The same fallback the sport variants use in the module this was
  /// modelled on: the specific one wins, the default catches the rest.
  ///
  /// ⚠️ A FORM type, not a request type. The bank details form, the FSSAI
  /// upload and staff registration all ask somebody to agree to something, and
  /// none of them is an application. The three shared names are deliberately
  /// the same strings, which is what let the widening migration leave every row
  /// where it was.
  formType StallFormType? @map("form_type")

  /// 1, then 2, then 3 — per (edition, key, requestType), not globally.
  version Int

  title  String
  /// Limited rich text: bold, links, line breaks. Never raw HTML from a
  /// paste — see `packages/stalls/src/declarations.ts` for what survives.
  body   String
  /// The Tamil beside the English. Null where the form has none, exactly as
  /// `label_ta` is null on the ashram form.
  bodyTa String? @map("body_ta")

  /// Whether a form still shows it. Retiring a declaration must not orphan the
  /// consents already given against it, so this is a flag and not a delete.
  isActive Boolean @default(true) @map("is_active")

  /// The version a form shows NOW. Exactly one per (edition, key, requestType)
  /// — enforced by a partial unique index, not by application code, because
  /// two live versions of a consent is the one state nobody can resolve after
  /// the fact.
  isCurrent Boolean @default(true) @map("is_current")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy  String?   @map("created_by")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz

  edition  StallEdition              @relation(fields: [editionId], references: [id], onDelete: Cascade)
  consents StallDeclarationConsent[]

  /// Version numbers do not repeat within a variant. Declared here (not only
  /// in SQL) because Prisma sees plain unique indexes and would otherwise
  /// generate a DROP for it as drift. Its three partial companions —
  /// `stall_declaration_one_current`, `_one_current_default` and
  /// `_version_default` — Prisma cannot express, so it leaves them alone.
  @@unique([editionId, key, formType, version], map: "stall_declaration_version")
  @@index([editionId, key])
  @@map("stall_declaration")
  @@schema("stalls")
}

/// One requester agreeing to one exact version.
///
/// ⚠️ `declaration_id` points at the VERSION, never at the key. That is the
/// whole point: reprinting what a vendor accepted means reading this row's
/// declaration, not today's wording.
model StallDeclarationConsent {
  id            String   @id @default(uuid()) @db.Uuid
  requestId     String   @map("request_id") @db.Uuid
  declarationId String   @map("declaration_id") @db.Uuid
  agreedAt      DateTime @default(now()) @map("agreed_at") @db.Timestamptz

  /// WHICH form the tick was on.
  ///
  /// 🔴 The same key can be ticked on the request form and again on the bank
  /// form, months apart, against wording that may have been re-versioned in
  /// between. Those are two consents. Without this column the second is
  /// silently discarded by `skipDuplicates` — the vendor saw a tick and the log
  /// has nothing.
  formType StallFormType @map("form_type")

  /// Set when the consent is one STAFF MEMBER'S rather than the requester's.
  ///
  /// ⚠️ Eight people register against one coupon and share a request id. The
  /// consent is the individual's — they are the one carrying the photo ID
  /// through the gate — so without this, seven of the eight collapse into the
  /// first person's row.
  staffId String? @map("staff_id") @db.Uuid

  request     StallRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  declaration StallDeclaration  @relation(fields: [declarationId], references: [id])
  staff       StallVendorStaff? @relation(fields: [staffId], references: [id], onDelete: Cascade)

  /// ⚠️ The two real constraints are PARTIAL unique indexes Prisma cannot
  /// express — `stall_declaration_consent_by_form` (the requester's own, where
  /// staff_id IS NULL) and `_by_staff` (one person's own). They live in the
  /// migration, exactly as `StallDeclaration`'s four already do. A plain
  /// `@@unique` here would be a different, wrong constraint, and Prisma would
  /// generate a DROP for the real ones as drift.
  @@index([requestId, formType])
  @@index([declarationId])
  @@index([staffId])
  @@map("stall_declaration_consent")
  @@schema("stalls")
}

/// A form, as data.
///
/// 🔴 The four 2025 forms were a constant in `packages/stalls/src/forms.ts` and
/// the Form Builder could only APPEND to them. Reordering a field, fixing a
/// label, or marking something required meant a code change and a redeploy —
/// an edition's form waiting on an engineer, which is the same problem the bay
/// list had before zones became rows.
///
/// The constants are the SEED now. These rows are what a form is.
model StallFormDefinition {
  id        String        @id @default(uuid()) @db.Uuid
  editionId String        @map("edition_id") @db.Uuid
  formType  StallFormType @map("form_type")

  title   String
  titleTa String? @map("title_ta")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy String?  @map("updated_by")

  edition  StallEdition       @relation(fields: [editionId], references: [id], onDelete: Cascade)
  sections StallFormSection[]
  fields   StallFormField[]

  @@unique([editionId, formType])
  @@map("stall_form_definition")
  @@schema("stalls")
}

/// A heading within a form, and the fields under it.
///
/// Optional: a field with no section renders in the form's own flow, which is
/// what the 2025 forms are — one run of questions with no headings at all.
model StallFormSection {
  id           String @id @default(uuid()) @db.Uuid
  definitionId String @map("definition_id") @db.Uuid

  heading   String
  headingTa String? @map("heading_ta")
  help      String?
  sortOrder Int     @map("sort_order")

  definition StallFormDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  fields     StallFormField[]

  @@index([definitionId, sortOrder])
  @@map("stall_form_section")
  @@schema("stalls")
}

/// One question.
///
/// ⚠️ This table WAS `stall_custom_field`, renamed rather than replaced: the
/// answers already given hang off it by foreign key, and a new table would have
/// meant migrating them or losing them. An appended custom field is simply a
/// field with `is_built_in` false — there is one kind of field now.
///
/// 🔴 `is_built_in` is the honest limit of "the whole form is data". These
/// fields' answers go into TYPED COLUMNS on `stall_request` — `stall_name`,
/// `email`, `num_stalls_requested` — so their `name` and `field_type` cannot be
/// edited: renaming one would post an answer the submit path has nowhere to
/// put, and retyping one would post a string into an integer column. Everything
/// a screen can actually control — the wording, the Tamil, the help, the order,
/// the section, whether it is required, whether it is asked at all — is
/// editable on every field, built-in or not.
model StallFormField {
  id           String  @id @default(uuid()) @db.Uuid
  editionId    String  @map("edition_id") @db.Uuid
  definitionId String? @map("definition_id") @db.Uuid
  sectionId    String? @map("section_id") @db.Uuid

  /// The key the answer travels under. For a built-in it is the contract's own
  /// field name; for an appended one it is null and the id is the key.
  name String?

  formType   StallFormType @map("form_type")
  label      String
  labelTa    String?       @map("label_ta")
  help       String?
  helpTa     String?       @map("help_ta")
  fieldType  String        @map("field_type")
  isRequired Boolean       @default(false) @map("is_required")
  sortOrder  Int           @map("sort_order")
  isActive   Boolean       @default(true) @map("is_active")

  /// Whose answer lands in a column on `stall_request`. Locked in the ways the
  /// model comment sets out.
  isBuiltIn Boolean @default(false) @map("is_built_in")

  /// `[{ value, label, labelTa }]` for a select or radio. Null for the rest.
  options Json?

  /// What the question accepts, beyond its type.
  ///
  /// 🔴 `min`/`max` are read THREE ways, decided by `field_type`: the VALUE for
  /// a number, the DIGIT count for a telephone number, and HOW MANY for a file
  /// or appliance list. One pair of columns, because they were one pair before
  /// the rest of this landed and the type already says which reading applies —
  /// `ruleKindOf` in `@msr/stalls` is what every reader goes through.
  min         Int?
  max         Int?
  /// text — the shortest and longest the answer may be.
  minLen      Int?    @map("min_len")
  maxLen      Int?    @map("max_len")
  /// number — digits allowed after the point. Null or 0 is a whole number.
  ///
  /// ⚠️ Never set on a BUILT-IN: every numeric column on `stall_request` is an
  /// integer, so a built-in that accepted 2.5 plug points would be rounded on
  /// its way in or refused by the contract. The API refuses the write.
  decimals    Int?
  /// text — an expression the answer must match, and what it is asking for in
  /// words. The message quotes the words, never the expression.
  pattern     String?
  patternHint String? @map("pattern_hint")
  /// date — the days the question accepts, as a `DateWindow`: pinned days, or a
  /// window that rolls with today.
  dateWindow  Json?   @map("date_window")

  /// The picture a `display` block draws, as a media-store key.
  ///
  /// 🔴 The ADMIN's picture, not a reader's answer. A `file` question's answer
  /// is the reader's and lands on their record; this is part of the QUESTION —
  /// the venue layout above "where would you like to stand" — so it belongs on
  /// the field row and travels with it when a form is copied to a new edition.
  mediaKey String? @map("media_key")

  edition    StallEdition            @relation(fields: [editionId], references: [id], onDelete: Cascade)
  definition StallFormDefinition?    @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  section    StallFormSection?       @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  values     StallCustomFieldValue[]

  @@index([editionId, formType])
  @@index([definitionId, sortOrder])
  @@map("stall_form_field")
  @@schema("stalls")
}

/// The Flow Builder's whole surface: three switches.
model StallFlowConfig {
  id                 String  @id @default(uuid()) @db.Uuid
  editionId          String  @unique @map("edition_id") @db.Uuid
  bankStepEnabled    Boolean @default(true) @map("bank_step_enabled")
  paymentStepEnabled Boolean @default(true) @map("payment_step_enabled")
  fssaiStepEnabled   Boolean @default(true) @map("fssai_step_enabled")

  edition StallEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@map("stall_flow_config")
  @@schema("stalls")
}

// ── Identity and access ─────────────────────────────────────────────────────

/// An external requester. Created on first submission; no password, no
/// verification (design decision 6). Never a host Person.
model StallAccount {
  id          String   @id @default(uuid()) @db.Uuid
  /// Normalised: trimmed, lowercased. The one lookup key.
  email       String   @unique
  phone       String
  displayName String   @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  requests    StallRequest[]
  accessLinks StallAccessLink[]
  credentials StallCredential[]

  @@map("stall_account")
  @@schema("stalls")
}

/// A requester's password. TEMPORARY — the host's Isha OIDC replaces it, and
/// this table is then dropped whole.
///
/// ⚠️ Deliberately NOT columns on `StallAccount`. `phone` there is not unique
/// and cannot become so — two stalls can share a shopkeeper's number under
/// different addresses, which `accounts.ts` relies on — so login identity has
/// to live where uniqueness can actually hold, and that is only among the
/// people who registered.
model StallCredential {
  id           String         @id @default(uuid()) @db.Uuid
  accountId    String         @map("account_id") @db.Uuid
  /// Normalised by `parseContact`: a lowercased email, or bare ten digits.
  loginValue   String         @unique @map("login_value")
  loginKind    StallLoginKind @map("login_kind")
  passwordHash String         @map("password_hash")
  failedCount  Int            @default(0) @map("failed_count")
  lockedUntil  DateTime?      @map("locked_until") @db.Timestamptz
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  account StallAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("stall_credential")
  @@schema("stalls")
}

/// The return-access mechanism. Only the HASH of the token is stored, so a
/// database leak does not hand out live links.
model StallAccessLink {
  id        String             @id @default(uuid()) @db.Uuid
  tokenHash String             @unique @map("token_hash")
  accountId String             @map("account_id") @db.Uuid
  requestId String?            @map("request_id") @db.Uuid
  purpose   StallAccessPurpose
  expiresAt DateTime           @map("expires_at") @db.Timestamptz
  usedAt    DateTime?          @map("used_at") @db.Timestamptz
  revokedAt DateTime?          @map("revoked_at") @db.Timestamptz
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz

  account StallAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  request StallRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("stall_access_link")
  @@schema("stalls")
}

// ── Module-owned RBAC ───────────────────────────────────────────────────────
//
// Host ADR 0016: which role a person holds is this module's own fact, granted
// on this module's own screen against its own tables. Host ADR 0018: what a
// role MEANS is data, so an admin retunes it without a deploy.
//
// The split that matters: the privilege vocabulary is developer-defined and
// seeded from `@msr/stalls`, because a privilege means nothing unless a route
// enforces it. Only the BUNDLING of privileges into roles is authored.

/// One thing a person can be allowed to do, named after what they DO rather
/// than after a screen — screens get renamed and merged, "may confirm a
/// payment" does not.
///
/// Seeded from `PRIVILEGE_CATEGORIES` in `@msr/stalls` and never written by the
/// application. `isActive` retires one without deleting it, so a role that
/// still bundles it keeps resolving.
model StallPrivilege {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  label       String
  /// The group the role editor lists this under, and the unit a role is
  /// usually granted whole.
  category    String
  /// view / action / config / sensitive / export. Presentation on the role
  /// editor — nothing branches on it at runtime.
  kind        String
  description String
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  roles StallRolePrivilege[]

  @@map("stall_privilege")
  @@schema("stalls")
}

/// A named bundle of privileges, and a place in the hierarchy.
///
/// `roleKey` rather than the uuid is what `StallBackofficeRole` stores and what the
/// host would carry on a participation, so it is stable and append-only: a role
/// may be re-labelled or retired, never re-keyed.
model StallRole {
  id                 String   @id @default(uuid()) @db.Uuid
  roleKey            String   @unique @map("role_key")
  name               String
  description        String
  /// The role this one sits under. Null is the root of a branch.
  ///
  /// Held as the KEY, not a uuid FK to this table: the seed writes the tree by
  /// name in one pass without a second update to wire parents up, and a key is
  /// what every other reference in this module already uses. `onDelete:
  /// SetNull` re-parents orphans to the root rather than cascading a subtree
  /// out of existence when one role is removed.
  parentKey          String?  @map("parent_key")
  /// The rank an admin typed, 0 being the top.
  ///
  /// ⚠️ STORED rather than derived by walking `parentKey`, which is how the
  /// reference module holds it too. It is a LABEL for the card and the picker:
  /// who may hand out which role is decided by the TREE and nothing else, so a
  /// level that disagrees with the parent chain reads oddly and changes
  /// nobody's reach. Derived depth was the alternative and it cannot express
  /// what an admin wants here — two sibling roles at different ranks.
  level              Int      @default(0)
  /// Shipped with the module. Blocks deletion and re-keying — never the editing
  /// of privileges, which is the whole point of roles being data.
  isSystem           Boolean  @default(false) @map("is_system")
  /// Carries every ACTIVE privilege, including ones added in a later release.
  /// A real grant, not an editor convenience: a role holding this has NO
  /// `stall_role_privilege` rows, so any query that only joins those rows
  /// misses it entirely.
  allPrivileges      Boolean  @default(false) @map("all_privileges")
  /// May hand out this role as well as the ones under it. Never a sibling.
  canAssignSameLevel Boolean  @default(false) @map("can_assign_same_level")
  /// Which requester types this role may reach. Empty is every type — see
  /// `unionRequestTypeScope`, which unions across the roles a person holds so a
  /// narrow role can never take access away from a broad one.
  ///
  /// ⚠️ Empty means UNSCOPED here, while an empty resolved scope means "reaches
  /// nothing". The difference is real: a role with no restriction and a person
  /// with no role are opposite answers. The resolver maps `[]` on the row to
  /// `null` in the rule.
  requestTypeScope   String[] @map("request_type_scope")
  sortOrder          Int      @map("sort_order")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  privileges StallRolePrivilege[]
  grants     StallBackofficeRole[]
  parent     StallRole?            @relation("StallRoleTree", fields: [parentKey], references: [roleKey], onDelete: SetNull, onUpdate: Cascade)
  children   StallRole[]           @relation("StallRoleTree")

  @@index([parentKey])
  @@map("stall_role")
  @@schema("stalls")
}

/// Which privileges a role bundles. Cascades on both sides: a deleted role
/// takes its bundle with it, and a privilege that no longer exists cannot leave
/// a row granting nothing.
model StallRolePrivilege {
  roleId      String @map("role_id") @db.Uuid
  privilegeId String @map("privilege_id") @db.Uuid

  role      StallRole      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  privilege StallPrivilege @relation(fields: [privilegeId], references: [id], onDelete: Cascade)

  @@id([roleId, privilegeId])
  @@index([privilegeId])
  @@map("stall_role_privilege")
  @@schema("stalls")
}

/// The grant: this person holds this role.
///
/// `personRef` is the host's person_id after migration; the stub Person's id
/// before it. Deliberately NOT a foreign key — the host's Person lives in
/// another schema owned by another module, and a module never reaches into
/// another's tables. `roleKey` IS one: `StallRole` is this module's own table,
/// and a grant naming a role that does not exist is a row nothing can resolve.
model StallBackofficeRole {
  id        String   @id @default(uuid()) @db.Uuid
  personRef String   @map("person_ref")
  roleKey   String   @map("role_key")
  grantedBy String   @map("granted_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  /// Which editions this grant reaches. Empty is every one, including editions
  /// created after the grant was made.
  ///
  /// ⚠️ Empty is deliberately "all", not "none" — a person given the whole event
  /// must not lose next year the moment somebody creates it, with nothing
  /// watching. A single-edition volunteer gets an explicit list instead, and simply
  /// stops reaching the module when the next edition is activated.
  ///
  /// Ids rather than years, and deliberately NOT a foreign key: an array column
  /// cannot carry one. A deleted edition therefore leaves a stale id behind,
  /// which is harmless — it can never match the active edition again — and the
  /// alternative, a join table, buys referential integrity for a value that is
  /// only ever compared against one id per request.
  editionScope String[] @map("edition_scope")

  /// Which bays this grant reaches, by zone CODE. Empty is every bay.
  ///
  /// Codes, not zone ids, because that is what a request carries
  /// (`preferred_zone_code` / `agreed_zone_code`) and because a bay marshal who
  /// runs A1 runs A1 every edition — a zone ROW is per-edition, so scoping by id
  /// would silently empty the grant the day next year's bays are created.
  zoneScope String[] @map("zone_scope")

  role StallRole @relation(fields: [roleKey], references: [roleKey], onDelete: Restrict, onUpdate: Cascade)

  @@unique([personRef, roleKey])
  @@index([roleKey])
  @@map("stall_backoffice_role")
  @@schema("stalls")
}

// ── Requests ────────────────────────────────────────────────────────────────

/// Per-edition, per-type counter, bumped inside the submit transaction so two
/// concurrent submissions cannot both take VEN-2026-0042.
model StallReferenceSequence {
  editionId   String           @map("edition_id") @db.Uuid
  requestType StallRequestType @map("request_type")
  next        Int              @default(1)

  edition StallEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@id([editionId, requestType])
  @@map("stall_reference_sequence")
  @@schema("stalls")
}

/// One table for every request form. They overlap by ~70%, and the pipeline,
/// search and export screens all read one list.
model StallRequest {
  id        String @id @default(uuid()) @db.Uuid
  editionId String @map("edition_id") @db.Uuid
  accountId String @map("account_id") @db.Uuid
  reference String @unique

  requestType StallRequestType @map("request_type")
  stallType   StallType        @map("stall_type")

  stallName     String  @map("stall_name")
  requesterName String  @map("requester_name")
  contactNumber String  @map("contact_number")
  email         String
  address       String?

  itemsSelling       String  @map("items_selling")
  numStallsRequested Int     @map("num_stalls_requested")
  preferredZoneCode  String  @map("preferred_zone_code")
  /// The bay the team and the requester settled on, which is not always the one
  /// that was asked for: "we may have to talk to them saying that side is
  /// already filled up, why don't you look at this side".
  ///
  /// ⚠️ This is what the stall is PRICED at once it is set. The sequence on the
  /// ground is: agree the bay, send the payment letter, allocate a number later
  /// — so between selection and allocation this is the only record of where the
  /// stall will stand, and pricing the requested bay instead is how a vendor
  /// gets billed for ground they were never given.
  agreedZoneCode     String? @map("agreed_zone_code")
  remarks            String?

  plugs5a   Int @default(0) @map("plugs_5a")
  plugs15a  Int @default(0) @map("plugs_15a")
  gasStoves Int @default(0) @map("gas_stoves")

  tablesNeeded Int @default(0) @map("tables_needed")
  chairsNeeded Int @default(0) @map("chairs_needed")
  passes2w     Int @default(0) @map("passes_2w")
  passes4w     Int @default(0) @map("passes_4w")
  passesStaff  Int @default(0) @map("passes_staff")

  agreedAt              DateTime  @map("agreed_at") @db.Timestamptz
  depositAcknowledgedAt DateTime? @map("deposit_acknowledged_at") @db.Timestamptz

  status       StallRequestStatus @default(SUBMITTED)
  stage        StallStage         @default(NEW)
  submittedAt  DateTime           @default(now()) @map("submitted_at") @db.Timestamptz
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  flaggedAt    DateTime?          @map("flagged_at") @db.Timestamptz
  flagReason   String?            @map("flag_reason")
  rejectReason String?            @map("reject_reason")

  edition      StallEdition              @relation(fields: [editionId], references: [id], onDelete: Cascade)
  account      StallAccount              @relation(fields: [accountId], references: [id])
  ashramDetail StallRequestAshramDetail?
  appliances   StallRequestAppliance[]
  customValues StallCustomFieldValue[]
  consents     StallDeclarationConsent[]
  allocations  StallAllocation[]
  accessLinks  StallAccessLink[]

  messages    StallMessageLog[]
  bankDetail  StallBankDetail?
  reminders   StallReminderCall[]
  paymentPlan   StallPaymentPlan?
  payments      StallPaymentRecord[]
  paymentClaims StallPaymentClaim[]
  fines         StallFine[]
  refund      StallRefund?
  coupons     StallStaffCoupon[]
  staff       StallVendorStaff[]
  fssai       StallFssaiCertificate?
  checkIn     StallCheckIn?
  equipment   StallEquipmentIssue?
  signature   StallContractSignature?

  @@index([editionId, status, stage])
  @@index([editionId, requestType])
  @@index([submittedAt(sort: Desc), id(sort: Desc)])
  @@map("stall_request")
  @@schema("stalls")
}

/// The ashram-only block. 1:1 optional.
model StallRequestAshramDetail {
  requestId             String           @id @map("request_id") @db.Uuid
  departmentHead        String           @map("department_head")
  departmentHeadContact String           @map("department_head_contact")
  department            String
  requestedBy           String           @map("requested_by")
  requesterContact      String           @map("requester_contact")
  creditCardNeeded      Boolean          @map("credit_card_needed")
  usage                 StallAshramUsage
  usageOther            String?          @map("usage_other")
  wantsThembu           Boolean          @map("wants_thembu")
  fssaiExpected         Boolean?         @map("fssai_expected")

  request StallRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("stall_request_ashram_detail")
  @@schema("stalls")
}

/// Child rows, not four nullable column pairs: the 2025 forms cap at 4 but the
/// 2025 DATA shows stalls listing more, and Phase 3's load sheet sums them.
model StallRequestAppliance {
  id        String @id @default(uuid()) @db.Uuid
  requestId String @map("request_id") @db.Uuid
  name      String
  watts     Int
  sortOrder Int    @map("sort_order")

  request StallRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("stall_request_appliance")
  @@schema("stalls")
}

model StallCustomFieldValue {
  id            String @id @default(uuid()) @db.Uuid
  requestId     String @map("request_id") @db.Uuid
  customFieldId String @map("custom_field_id") @db.Uuid
  value         String

  /// Set when the answer is one STAFF MEMBER'S rather than the stall's. Eight
  /// people register against one coupon and share a request; without this,
  /// seven of their answers collapse into the first person's row.
  staffId String? @map("staff_id") @db.Uuid

  request StallRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  field   StallFormField    @relation(fields: [customFieldId], references: [id])
  staff   StallVendorStaff? @relation(fields: [staffId], references: [id], onDelete: Cascade)

  /// ⚠️ The two real constraints are PARTIAL unique indexes Prisma cannot
  /// express — `_by_request` (staff_id IS NULL) and `_by_staff`. They live in
  /// the migration, like the pairs on `stall_declaration` and its consent log.
  /// No plain index on (request_id, custom_field_id) is declared: `_by_request`
  /// already covers that lookup for every row a request owns, and a duplicate
  /// would cost a write on each insert to buy nothing.
  @@index([staffId])
  @@map("stall_custom_field_value")
  @@schema("stalls")
}

/// A request holding a stall. A request for 3 stalls yields 3 rows.
///
/// `activeStallId` is the DATABASE-ENFORCED single occupant: it is UNIQUE and
/// non-null while the allocation is live, and set to null on release. Two
/// backoffice selecting the same stall at once therefore cannot both succeed — the
/// second insert violates the constraint, whatever the application checked.
/// `stallId` stays populated after release so the history survives.
model StallAllocation {
  id            String    @id @default(uuid()) @db.Uuid
  requestId     String    @map("request_id") @db.Uuid
  stallId       String    @map("stall_id") @db.Uuid
  activeStallId String?   @unique @map("active_stall_id") @db.Uuid
  allocatedAt   DateTime  @default(now()) @map("allocated_at") @db.Timestamptz
  allocatedBy   String    @map("allocated_by")
  releasedAt    DateTime? @map("released_at") @db.Timestamptz
  releasedBy    String?   @map("released_by")

  request     StallRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stall       Stall        @relation("StallAllocationHistory", fields: [stallId], references: [id])
  activeStall Stall?       @relation("StallActiveAllocation", fields: [activeStallId], references: [id])

  @@index([requestId])
  @@map("stall_allocation")
  @@schema("stalls")
}

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 2 — Onboarding & money
// ═══════════════════════════════════════════════════════════════════════════

enum StallTemplateKey {
  SELECTION_VENDOR
  SELECTION_ASHRAM
  PAYMENT_DETAILS
  ONBOARDING_FSSAI_STAFF

  @@schema("stalls")
}

enum StallPaymentPurpose {
  RENT
  DEPOSIT

  @@schema("stalls")
}

enum StallPaymentClaimStatus {
  PENDING
  VERIFIED
  REJECTED

  @@schema("stalls")
}

/// A vendor's own account of a transfer they have made.
///
/// 🔴 NOT a `StallPaymentRecord`. That table is finance-entered — `confirmedBy`
/// is required — so every row in it is money the Foundation has seen on its
/// statement. A claim is what somebody SAYS they paid, and the two must never be
/// the same table: every query that reads a payment as settled would then need a
/// `WHERE confirmed_by IS NOT NULL`, and the one that forgot would count
/// unverified money silently.
///
/// The 2025 letter filled this gap with "please send transfer details on E-mail
/// IDs finance.support@… once you make the payment" — a mailbox, matched by
/// hand.
model StallPaymentClaim {
  id        String                   @id @default(uuid()) @db.Uuid
  requestId String                   @map("request_id") @db.Uuid
  purpose   StallPaymentPurpose
  status    StallPaymentClaimStatus  @default(PENDING)

  /// What the vendor typed off their bank statement.
  referenceNo  String   @map("reference_no")
  amountPaise  Int      @map("amount_paise")
  /// A banking DATE, not an instant — the day the transfer shows on the
  /// statement, which is what finance matches against.
  paidOn       DateTime @map("paid_on") @db.Date
  remitterName String?  @map("remitter_name")
  /// A media-store key. Optional: a vendor who transferred at a branch counter
  /// may have only a stamped slip they cannot photograph well, and refusing the
  /// claim over that sends them back to email.
  receiptKey   String?  @map("receipt_key")
  note         String?

  submittedAt DateTime @default(now()) @map("submitted_at") @db.Timestamptz

  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz
  reviewedBy String?   @map("reviewed_by")
  /// ⚠️ Required on REJECTED, enforced by a CHECK rather than by application
  /// code. A rejection with no reason is one the vendor cannot act on, and this
  /// text is shown to them.
  rejectReason String? @map("reject_reason")

  /// The confirmed receipt this claim became, set on VERIFIED.
  paymentRecordId String? @map("payment_record_id") @db.Uuid

  request       StallRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  paymentRecord StallPaymentRecord? @relation(fields: [paymentRecordId], references: [id], onDelete: SetNull)

  /// ⚠️ The real constraint is a PARTIAL unique index Prisma cannot express —
  /// `stall_payment_claim_live_reference`, over (request, reference) where the
  /// status is not REJECTED. A rejected claim keeps its reference so the vendor
  /// can be shown what was wrong, and they must still be able to resubmit a
  /// corrected claim carrying the same UTR.
  @@index([requestId])
  @@index([status, submittedAt])
  @@map("stall_payment_claim")
  @@schema("stalls")
}

enum StallPaymentMode {
  NEFT
  CASH
  CHEQUE
  UPI
  OTHER

  @@schema("stalls")
}

enum StallReminderKind {
  BANK
  PAYMENT

  @@schema("stalls")
}

enum StallIdType {
  AADHAAR
  VOTER_ID
  DRIVING_LICENCE
  PASSPORT
  OTHER

  @@schema("stalls")
}

/// The editable body of each outbound letter. Seeded per edition from
/// `DEFAULT_TEMPLATES` so an admin edits text rather than asking for a deploy,
/// and so 2027's wording can differ from 2026's without rewriting history.
model StallEmailTemplate {
  id              String           @id @default(uuid()) @db.Uuid
  editionId       String           @map("edition_id") @db.Uuid
  key             StallTemplateKey
  subject         String
  body            String
  /// The WhatsApp wording. Short, no attachment, written to be read on a phone
  /// — a letter pasted into WhatsApp whole is a wall of text nobody scrolls.
  /// Empty means this template is email-only, which the send path treats as an
  /// absence rather than a failure.
  whatsappBody    String           @default("") @map("whatsapp_body")
  /// The zone map or contract that goes out with the letter. A media-store key,
  /// not bytes — the module never holds a file in a column.
  attachmentKey   String?          @map("attachment_key")
  attachmentName  String?          @map("attachment_name")
  attachmentBytes Int?             @map("attachment_bytes")
  /// Null while the seeded wording has never been touched.
  updatedAt       DateTime?        @map("updated_at") @db.Timestamptz
  updatedBy       String?          @map("updated_by")

  edition StallEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@unique([editionId, key])
  @@map("stall_email_template")
  @@schema("stalls")
}

/// One row per letter actually sent. The UNIQUE is the requirement — "once the
/// email is sent it should not be sent again" — enforced by the database rather
/// than by a flag the bulk sender could race against.
/// One row per letter actually sent, per channel.
///
/// ⚠️ The uniqueness that stops a requester getting the same letter twice is now
/// per CHANNEL: a WhatsApp message that failed must not block the email, and a
/// team that sent the email in January must still be able to send the WhatsApp
/// in February. "Has this person been told" is therefore a question about a
/// channel, and every screen that asks it says which.
model StallMessageLog {
  id          String              @id @default(uuid()) @db.Uuid
  requestId   String              @map("request_id") @db.Uuid
  templateKey StallTemplateKey    @map("template_key")
  channel     StallMessageChannel @default(EMAIL)
  /// The address or number it went to, as it was at the moment of sending. Kept
  /// verbatim rather than re-read from the request, because "where did this
  /// actually go" is the question asked when a requester says they never got it
  /// — and by then the request may carry a corrected address.
  sentTo      String              @map("sent_to")
  subject     String
  sentAt      DateTime            @default(now()) @map("sent_at") @db.Timestamptz
  sentBy      String              @map("sent_by")

  request StallRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, templateKey, channel])
  @@index([templateKey, sentAt])
  @@map("stall_message_log")
  @@schema("stalls")
}

/// The stall agreement, sent for digital signature.
///
/// The terms used to be a tick-box on the request form. The legal team now
/// sends the agreement out through a signature provider, and the ask was that
/// it happen inside this application rather than in a parallel mailbox. A
/// tick-box and a signature are not the same artefact: one says a person saw a
/// paragraph, the other is a document with an audit trail that can be produced
/// if a stall is ever in dispute.
///
/// ⚠️ No document bytes here, and no provider credentials. `documentId` is the
/// provider's own handle, kept so a dispute can be traced into their audit
/// trail without going through this application at all.
model StallContractSignature {
  requestId  String               @id @map("request_id") @db.Uuid
  status     StallSignatureStatus @default(NOT_SENT)
  provider   String
  documentId String?              @map("document_id")
  /// Short-lived and reissued on demand rather than relied on: a signing URL
  /// that has expired is worse than none, because a requester will try it.
  signUrl    String?              @map("sign_url")
  sentAt     DateTime?            @map("sent_at") @db.Timestamptz
  sentBy     String?              @map("sent_by")
  signedAt   DateTime?            @map("signed_at") @db.Timestamptz
  /// Why the provider refused, when it did — shown to the team verbatim.
  error      String?
  updatedAt  DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  request StallRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("stall_contract_signature")
  @@schema("stalls")
}

/// What the vendor typed on the Bank Details and Requirements form, 1:1 with
/// the request.
///
/// This is the module's most sensitive table: it is where the refund goes. It
/// holds no card data and no file bytes — the cancelled cheque, PAN and GST
/// certificate are media-store KEYS, presigned for a few minutes when a backoffice
/// member opens one, so the objects are never public and never in a backup of
/// this database.
model StallBankDetail {
  requestId String @id @map("request_id") @db.Uuid

  /// ⚠️ EVERY answer below is optional at the database level, and none of them
  /// is optional on the form by default. What this form insists on is
  /// `is_required` on its field rows — an admin may mark a question optional or
  /// stop asking it, and a NOT NULL here would turn that configuration choice
  /// into a 500 at submit time. Nullability is the floor, not the policy.
  email         String?
  invoiceName   String? @map("invoice_name")
  accountHolder String? @map("account_holder")
  mobile        String?
  address       String?
  pincode       String?
  bankName      String? @map("bank_name")
  branch        String?
  accountNumber String? @map("account_number")
  ifsc          String?
  micr          String?
  panNumber     String? @map("pan_number")
  /// Stored as typed, including the literal "NONE" the 2025 form asks for.
  gstNumber     String? @map("gst_number")

  chequeKey String? @map("cheque_key")
  panKey    String? @map("pan_key")
  gstKey    String? @map("gst_key")

  agreedNeftAt  DateTime @map("agreed_neft_at") @db.Timestamptz
  agreedTermsAt DateTime @map("agreed_terms_at") @db.Timestamptz
  remarks       String?
  submittedAt   DateTime @default(now()) @map("submitted_at") @db.Timestamptz

  request StallRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("stall_bank_detail")
  @@schema("stalls")
}

/// "Reminder call for people pending entry for bank details" — a log, not a
/// counter, because the team's question is when someone was last called and by
/// whom, not how many times in total.
model StallReminderCall {
  id        String            @id @default(uuid()) @db.Uuid
  requestId String            @map("request_id") @db.Uuid
  kind      StallReminderKind
  note      String?
  calledAt  DateTime          @default(now()) @map("called_at") @db.Timestamptz
  calledBy  String            @map("called_by")

  request StallRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, kind])
  @@map("stall_reminder_call")
  @@schema("stalls")
}

/// The amount the vendor was actually TOLD to pay, frozen when the payment
/// email went out.
///
/// The live quote is computed from the rate card, so it moves when an admin
/// edits a rate. Finance reconciles a bank credit against the figure in the
/// vendor's inbox, which does not move. Keeping only the live quote is how a
/// rate correction in February turns every February payment into a mismatch.
model StallPaymentPlan {
  requestId             String   @id @map("request_id") @db.Uuid
  stallFeePaise         Int      @map("stall_fee_paise")
  plugFeePaise          Int      @map("plug_fee_paise")
  equipmentFeePaise     Int      @map("equipment_fee_paise")
  netPaise              Int      @map("net_paise")
  gstPaise              Int      @map("gst_paise")
  feeTotalPaise         Int      @map("fee_total_paise")
  stallDepositPaise     Int      @map("stall_deposit_paise")
  equipmentDepositPaise Int      @map("equipment_deposit_paise")
  depositTotalPaise     Int      @map("deposit_total_paise")
  quotedAt              DateTime @default(now()) @map("quoted_at") @db.Timestamptz

  /// The itemised charges as they stood when the letter went out — `QuoteLine[]`.
  ///
  /// 🔴 Frozen, not recomputed. The plan is what the vendor was TOLD, and a
  /// vendor who revised their plug points after the letter would otherwise get
  /// a reprint whose lines no longer add up to the total beside them.
  ///
  /// Null on plans frozen before this column existed; the letter then prints
  /// the summed figures it always did.
  lines                 Json?

  /// What was actually agreed, where the team agreed something other than the
  /// quote.
  ///
  /// 🔴 A local welfare stall is priced off the rate card and then settled at
  /// whatever the local welfare team judged the trader could give: "for A3 the
  /// cost is 10,000 — for the coconut wala, probably we will give that stall at
  /// 5,000". The call is theirs, per stall, and made after the quote exists.
  /// With nowhere to record it, the quoted figure is the only figure the system
  /// knows and a stall that paid the agreed amount never counts as settled.
  ///
  /// `feeTotalPaise` above is never rewritten — it is what the requester was
  /// told. This is what is owed. The gap between them is the concession, and
  /// the team is entitled to see it.
  ///
  /// ⚠️ Replaces the FEE only. The deposit comes back in full, so discounting it
  /// would mean refunding money that was never taken.
  discretionaryFeePaise Int?      @map("discretionary_fee_paise")
  /// Required whenever the figure above is set: an amount below the card rate
  /// with nothing beside it is indistinguishable from a typo six months later.
  discretionaryReason   String?   @map("discretionary_reason")
  discretionarySetAt    DateTime? @map("discretionary_set_at") @db.Timestamptz
  discretionarySetBy    String?   @map("discretionary_set_by")

  request StallRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("stall_payment_plan")
  @@schema("stalls")
}

/// A credit Finance has confirmed. Several per request: the 2025 sheet settles
/// rent and deposit as separate transfers, sometimes on different days.
model StallPaymentRecord {
  id           String              @id @default(uuid()) @db.Uuid
  requestId    String              @map("request_id") @db.Uuid
  purpose      StallPaymentPurpose
  referenceNo  String              @map("reference_no")
  /// The virtual-account code the credit landed on, where there is one.
  eCollectCode String?             @map("e_collect_code")
  amountPaise  Int                 @map("amount_paise")
  /// A banking date, not an instant — the credit date on the statement.
  receivedOn   DateTime            @map("received_on") @db.Date
  remitterName String?             @map("remitter_name")
  mode         StallPaymentMode    @default(NEFT)
  note         String?
  confirmedAt  DateTime            @default(now()) @map("confirmed_at") @db.Timestamptz
  confirmedBy  String              @map("confirmed_by")

  request StallRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  claims  StallPaymentClaim[]

  /// One reference number is one credit. Entering it twice — the same NEFT
  /// pasted into two rows on a busy afternoon — would double-count what the
  /// vendor paid and shrink their refund.
  @@unique([requestId, referenceNo])
  @@index([requestId])
  @@map("stall_payment_record")
  @@schema("stalls")
}

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 3 — Event operations
// ═══════════════════════════════════════════════════════════════════════════

/// The secure coupon a vendor's own staff register with. See `coupons.ts` for
/// what the code is made of and why.
model StallStaffCoupon {
  id        String    @id @default(uuid()) @db.Uuid
  /// 🔴 NOT the primary key any more. A stall may hold SEVERAL live coupons —
  /// "if they want more staff members" the team issues another rather than
  /// stretching one — so a caterer and the vendor's own kitchen team can be
  /// handed separate codes and counted separately.
  requestId String    @map("request_id") @db.Uuid
  code      String    @unique
  /// How many people this coupon may register. Eight by default — the team's
  /// own figure — and raised case by case by the stall team.
  ///
  /// ⚠️ A property of the COUPON, not of the request, and deliberately not the
  /// vendor's own "staff passes" answer: that is what they asked for on a form
  /// months earlier, this is what the stall team has agreed to let through the
  /// gate, and the gate enforces the second. It is also always a real cap —
  /// never zero meaning unlimited, which is how a stall with eight passes ends
  /// up registering eighty.
  capacity  Int       @default(8)
  issuedAt  DateTime  @default(now()) @map("issued_at") @db.Timestamptz
  issuedBy  String    @map("issued_by")
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz

  request StallRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  staff   StallVendorStaff[]

  @@index([requestId])
  @@map("stall_staff_coupon")
  @@schema("stalls")
}

/// A person who will work on a stall. Not a host `Person` and never becomes
/// one: they are a visitor for one event, recorded by the vendor, and the
/// directory is for people the organisation has a relationship with.
model StallVendorStaff {
  id        String @id @default(uuid()) @db.Uuid
  requestId String @map("request_id") @db.Uuid

  name String?

  /// 🔴 The ONE question on these three forms that cannot be switched off or
  /// made optional. It is half of the unique index behind "one person, one
  /// registration per stall", which is what stops somebody handed two coupon
  /// codes appearing twice and being counted twice at the gate. A nullable
  /// mobile makes that index toothless, because NULLs compare as DISTINCT and
  /// every registration without one would read as a new person.
  ///
  /// `LOCKED_REQUIRED` in `public-forms.ts` is where the Form Builder and the
  /// API both read that. Structural, not a preference.
  mobile String

  idType       StallIdType? @map("id_type")
  /// For an Aadhaar this is the last four digits only — enough to match the
  /// card at the gate, not enough to be a copy of it.
  idNumber     String?     @map("id_number")
  role         String?
  registeredAt DateTime    @default(now()) @map("registered_at") @db.Timestamptz
  /// WHICH coupon this person came in on, so a stall holding two codes can be
  /// told how far each has been used. Nullable for the registrations that
  /// predate a stall being able to hold more than one.
  couponId     String?     @map("coupon_id") @db.Uuid

  request  StallRequest              @relation(fields: [requestId], references: [id], onDelete: Cascade)
  coupon       StallStaffCoupon?         @relation(fields: [couponId], references: [id], onDelete: SetNull)
  consents     StallDeclarationConsent[]
  customValues StallCustomFieldValue[]

  /// One phone number, one registration per stall. Re-submitting the same
  /// person — the common case when a form is refreshed — must not inflate the
  /// count the check-in counter reads.
  @@unique([requestId, mobile])
  @@index([requestId])
  @@index([couponId])
  @@map("stall_vendor_staff")
  @@schema("stalls")
}

model StallFssaiCertificate {
  requestId   String    @id @map("request_id") @db.Uuid
  ownerName   String?   @map("owner_name")
  mobile      String?
  submittedAt DateTime  @default(now()) @map("submitted_at") @db.Timestamptz
  verifiedAt  DateTime? @map("verified_at") @db.Timestamptz
  verifiedBy  String?   @map("verified_by")

  request StallRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  files   StallFssaiFile[]

  @@map("stall_fssai_certificate")
  @@schema("stalls")
}

model StallFssaiFile {
  id         String   @id @default(uuid()) @db.Uuid
  requestId  String   @map("request_id") @db.Uuid
  fileKey    String   @map("file_key")
  fileName   String   @map("file_name")
  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz

  certificate StallFssaiCertificate @relation(fields: [requestId], references: [requestId], onDelete: Cascade)

  @@index([requestId])
  @@map("stall_fssai_file")
  @@schema("stalls")
}

model StallCheckIn {
  requestId   String   @id @map("request_id") @db.Uuid
  checkedInAt DateTime @default(now()) @map("checked_in_at") @db.Timestamptz
  checkedInBy String   @map("checked_in_by")
  note        String?

  request StallRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("stall_check_in")
  @@schema("stalls")
}

/// The chairs-and-tables counter, one row per stall.
///
/// `chairsRequested` and `tablesRequested` are COPIED from the request when the
/// row is opened rather than read through it. The counter hands out what the
/// challan says; if the request were edited afterwards the paper slip and the
/// screen would disagree, and the vendor is holding the paper.
model StallEquipmentIssue {
  requestId        String    @id @map("request_id") @db.Uuid
  chairsRequested  Int       @map("chairs_requested")
  tablesRequested  Int       @map("tables_requested")
  extraChairs      Int       @default(0) @map("extra_chairs")
  extraTables      Int       @default(0) @map("extra_tables")
  /// Cash taken at the counter for the extras, at this requester type's rate.
  extraChargePaise Int       @default(0) @map("extra_charge_paise")
  extraCollectedAt DateTime? @map("extra_collected_at") @db.Timestamptz
  distributedAt    DateTime? @map("distributed_at") @db.Timestamptz
  distributedBy    String?   @map("distributed_by")
  collectedAt      DateTime? @map("collected_at") @db.Timestamptz
  collectedBy      String?   @map("collected_by")
  missingChairs    Int       @default(0) @map("missing_chairs")
  missingTables    Int       @default(0) @map("missing_tables")
  damaged          Boolean   @default(false)
  note             String?
  flagged          Boolean   @default(false)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  request StallRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("stall_equipment_issue")
  @@schema("stalls")
}

/// A deduction from the deposit. Separate rows rather than one summed column so
/// the refund voucher can itemise what was withheld — a vendor disputing a
/// deduction is owed the list, not the total.
model StallFine {
  id          String   @id @default(uuid()) @db.Uuid
  requestId   String   @map("request_id") @db.Uuid
  /// Null for a one-off fine with no configured category.
  fineTypeId  String?  @map("fine_type_id") @db.Uuid
  reason      String
  amountPaise Int      @map("amount_paise")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy   String   @map("created_by")

  request StallRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("stall_fine")
  @@schema("stalls")
}

/// What the stalls team hands Finance. Written once, when the team submits the
/// row; the figures are frozen at that moment because Finance pays against them.
model StallRefund {
  requestId String @id @map("request_id") @db.Uuid

  /// 🔴 TWO deposits, because each deduction is charged to its own: "the chairs
  /// & tables not returned and damaged ... will be deducted from deposit
  /// against chairs and tables", and "any penalty against unclean stalls ...
  /// will be deducted from stall deposit". The 2025 payment sheet carries both
  /// columns and the quote has always computed them apart.
  ///
  /// `depositHeldPaise` is their sum, kept because it is what the voucher pays
  /// against and what a vendor asking "how much did I put in" is owed.
  stallDepositPaise       Int @default(0) @map("stall_deposit_paise")
  equipmentDepositPaise   Int @default(0) @map("equipment_deposit_paise")
  depositHeldPaise        Int @map("deposit_held_paise")
  equipmentDeductionPaise Int @map("equipment_deduction_paise")
  fineDeductionPaise      Int @map("fine_deduction_paise")
  refundDuePaise          Int @map("refund_due_paise")

  /// Deductions beyond the deposit they are charged against. Chased separately;
  /// never a negative refund. Per bucket, because an over-run on furniture is a
  /// debt to recover rather than a reason to keep the stall deposit.
  stallShortfallPaise     Int      @default(0) @map("stall_shortfall_paise")
  equipmentShortfallPaise Int      @default(0) @map("equipment_shortfall_paise")
  shortfallPaise          Int      @default(0) @map("shortfall_paise")
  note                    String?
  voucherRef              String?  @map("voucher_ref")
  submittedAt             DateTime @default(now()) @map("submitted_at") @db.Timestamptz
  submittedBy             String   @map("submitted_by")

  request StallRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("stall_refund")
  @@schema("stalls")
}
