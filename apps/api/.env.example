# Local Postgres. Create the dev DB once:
#   createdb msr_stalls_dev
# then copy this file to .env. Tests use a SEPARATE database — see
# .env.test.example. Never point them here: the suite TRUNCATEs every table.
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/msr_stalls_dev?schema=public"
PORT=3000

# Where the development media store keeps uploaded files (FSSAI certificates,
# cancelled cheques). Any writable directory. Unset = uploads disabled.
MSR_DEV_MEDIA_DIR=".media"

# Allowed browser origin for CORS in development.
WEB_ORIGIN="http://localhost:5173"
