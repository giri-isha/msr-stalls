{
  "name": "stall-management",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "postinstall": "npm run db:generate",
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run typecheck && npm run build --workspace=apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "lint:boundaries": "depcruise apps/web/src apps/api/src --config .dependency-cruiser.cjs",
    "db:generate": "npm run db:generate --workspace=apps/api",
    "db:migrate": "npm run db:migrate --workspace=apps/api",
    "db:seed": "npm run db:seed --workspace=apps/api"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@swc/core": "^1.15.46",
    "concurrently": "^9.1.0",
    "dependency-cruiser": "^18.1.0",
    "prisma": "8.1.0-dev.6"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "prisma": true,
    "esbuild": true
  }
}
